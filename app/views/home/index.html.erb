<div style="max-width: 800px; margin: 2rem auto; padding: 2rem;">
  <h1>Welcome to FileShare</h1>
  
  <% if logged_in? %>
    <div style="background-color: #e8f5e9; border: 1px solid #4caf50; padding: 1.5rem; border-radius: 8px; margin: 1.5rem 0;">
      <h2 style="margin-top: 0; color: #2e7d32;">✓ Authenticated</h2>
      <p><strong>Name:</strong> <%= current_user.name %></p>
      <p><strong>Email:</strong> <%= current_user.email %></p>
      <p><strong>Provider:</strong> <%= current_user.provider.titleize %></p>
      
      <%= button_to "Logout", logout_path, 
          method: :delete,
          data: { turbo: false },
          style: "background-color: #d32f2f; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; margin-top: 1rem;" %>
    </div>
    
    <div style="background-color: #f5f5f5; padding: 1.5rem; border-radius: 8px; margin-top: 2rem;">
      <h3>Protected Content</h3>
      <p>This is an example of content that only authenticated users can see.</p>
      <p>You can now access all features of the application.</p>
    </div>
  <% else %>
    <div style="background-color: #fff3e0; border: 1px solid #ff9800; padding: 1.5rem; border-radius: 8px; margin: 1.5rem 0;">
      <h2 style="margin-top: 0; color: #e65100;">⚠ Not Authenticated</h2>
      <p>You need to sign in to access the application features.</p>
      
      <%= link_to "Sign In", login_path, 
          style: "display: inline-block; background-color: #0078d4; color: white; text-decoration: none; padding: 10px 20px; border-radius: 4px; margin-top: 1rem;" %>
    </div>
  <% end %>
  
  <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #ddd;">
    <h3>About This Application</h3>
    <p>This application uses Microsoft Entra ID (Azure AD) for authentication.</p>
    <ul>
      <li>Secure OAuth 2.0 authentication</li>
      <li>Single Sign-On (SSO) capability</li>
      <li>Enterprise-grade security</li>
    </ul>
  </div>
</div>
