<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh;">
  <div style="text-align: center; max-width: 400px; padding: 2rem; border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h1 style="margin-bottom: 2rem;">Sign In</h1>
    
    <p style="margin-bottom: 2rem; color: #666;">
      Sign in with your Microsoft Entra ID account to access FileShare.
    </p>
    
    <%= button_to "Sign in with Microsoft", "/auth/entra_id", 
        method: :post,
        data: { turbo: false },
        style: "background-color: #0078d4; color: white; border: none; padding: 12px 24px; font-size: 16px; border-radius: 4px; cursor: pointer; width: 100%;" %>
  </div>
</div>
