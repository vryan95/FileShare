= title t('.home')

= component :card_deck, reflex_root: true, id: "uploaded_files_root" do |c|
  = c.with_card tabs: [{id: "my_files_tab", text: t('.my_files')}, {id: "shared_files_tab", text: t('.shared_files')}] do |card|
    = card.with_header
      = button_tag type: "button", class: "btn btn-sm btn-primary", data: { bs_toggle: "modal", bs_target: "#uploadFileModal" } do
        = icon("cloud-arrow-up")
        span.ms-1 = t(".upload")
    = card.with_body do
      .tab-content
        #my_files_tab.tab-pane.fadeIn.show.active role="tabpanel"
          .table-responsive
            table.table 
              thead
                tr
                  th = t('.filename')
                  th = t('.size')
                  th = t('.share_type')
                  th = t('.expires_at')
                  th.text-center = t('.actions')
              tbody
                - @uploaded_files.each do |file|
                  - edit_modal_id = "editFileModal-#{file.upload_uuid}"
                  tr
                    td = file.filename
                    td = number_to_human_size(file.file_size)
                    td = t("share_types.#{file.share_type}")
                    td = l(file.expires_at.to_date, format: :slash)
                    td.text-center
                      = link_to icon('eye'), uploaded_file_path(file), title: t('.view'), class: "btn btn-sm btn-outline-primary me-2"
                      = button_tag type: "button", class: "btn btn-sm btn-outline-secondary me-2", title: t(".edit"), data: { bs_toggle: "modal", bs_target: "##{edit_modal_id}" } do
                        = icon("pencil-square")
                      = link_to icon('trash'), uploaded_file_path(file), data: { turbo_method: :delete, turbo_confirm: t('.confirm_delete') }, title: t('.delete'), class: "btn btn-sm btn-outline-danger"
          - @uploaded_files.each do |file|
            = component :edit_upload, uploaded_file: file
        #shared_files_tab.tab-pane.fadeIn role="tabpanel"
          .table-responsive
            table.table 
              thead
                tr
                  th = t('.filename')
                  th = t('.size')
                  th = t('.owner')
                  th = t('.expires_at')
                  th.text-center = t('.actions')
              tbody
                - @shared_files.each do |file|
                  tr
                    td = file.filename
                    td = number_to_human_size(file.file_size)
                    td = file.user.name
                    td = l(file.expires_at.to_date, format: :slash)
                    td.text-center
                      = link_to icon('eye'), uploaded_file_path(file), title: t('.view'), class: "btn btn-sm btn-outline-primary"

#uploadFileModal.modal.fade tabindex="-1" aria-labelledby="uploadFileModalLabel" aria-hidden="true"
  .modal-dialog.modal-xl.modal-dialog-centered.upload-file-modal__dialog
    .modal-content
      .modal-header
        h2#uploadFileModalLabel.modal-title.fs-5 = t(".upload_modal_title")
        button.btn-close type="button" data-bs-dismiss="modal" aria-label=t(".close")
      .modal-body
        = component :upload_dropzone, uploaded_file: @new_file
